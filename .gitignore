**/.env
*.pem
*.key
*.crt
*.p12
.claude/settings.local.json

# Dépôt du générateur (11/09) : /mnt/web est désormais son propre dépôt Git
# (remote configPEaaS.git), imbriqué mais non déclaré comme sous-module ici
# (docs/03 § Dépôts). Rien de son contenu ne doit être suivi par CE dépôt.
/web/
certs/

# Dépôt du socle (D-001) : PEaaSrepo/ est son propre dépôt Git (remote
# PEaaSrepo.git). Il était suivi ici comme gitlink nu (mode 160000, sans
# .gitmodules) — retiré : trois dépôts indépendants, aucun sous-module
# déclaré (docs/03 § Dépôts).
/PEaaSrepo/

# Sorties d'install.sh sur la VM cible (dans l'archive extraite, jamais ici)
docker-compose.override.yml
*/tls/
